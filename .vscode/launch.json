{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug",
            "cwd": "${workspaceRoot}",
            // Explicit, rather than ${command:cmake.launchTargetPath}: this
            // project still builds the M0 bring-up target `duke3d` alongside the
            // game, and that one only shows colour bars -- so if CMake Tools has
            // it selected as the launch target, F5 flashes a test pattern. The
            // build directory is pinned in settings.json to match the scripts.
            "executable": "${workspaceFolder}/build_fruitjam/src/pico/duke3d_game.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            // This may need to be "arm-none-eabi-gdb" for some previous builds
            "gdbPath" : "gdb-multiarch",
            "device": "RP2350",
	     "serverArgs": [
                "-c", "adapter speed 5000"
            ],
            "configFiles": [
                // This may need to be "interface/picoprobe.cfg" for some previous builds
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "${env:PICO_SDK_PATH}/src/rp2350/hardware_regs/rp2350.svd",
            "runToEntryPoint": "main",
            // Work around for stopping at main on restart
            "postRestartCommands": [
                "break main",
                "continue"
            ]
        }
    ]
}
